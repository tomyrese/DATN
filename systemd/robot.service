[Unit]
Description=Autonomous Mall Robot Central Platform (Raspberry Pi 4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/KLTN/Code
ExecStart=/home/pi/KLTN/Code/.venv/bin/python3 src/main.py
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
