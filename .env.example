# ==============================================================================
# ROBOT TỰ HÀNH TRUNG TÂM THƯƠNG MẠI (MALL ASSISTANT ROBOT) — CONFIGURATION
# ==============================================================================

# --- Operating Mode ---
SIMULATION_MODE=true
DEBUG_PREVIEW=false
DATABASE_PATH=data/mall_delivery.db

# --- Motor & PWM Configuration (2x TB6612FNG, 4 DC Motors) ---
PWM_FREQ=1000
DEFAULT_SPEED=0.35
MOTOR_ENABLED=true

# Left Motor Driver (TB6612FNG 1)
STBY_L=27
AIN1_L=5
AIN2_L=6
PWMA_L=13
BIN1_L=26
BIN2_L=22
PWMB_L=19

# Right Motor Driver (TB6612FNG 2)
STBY_R=21
PWMA_R=12
AIN1_R=16
AIN2_R=20
PWMB_R=18
BIN1_R=23
BIN2_R=24

# --- Dual HC-SR04 Ultrasonic Distance Sensors ---
# WARNING: Echo pins output 5V. Raspberry Pi 4 GPIO is 3.3V ONLY!
# Always install a 1k:2k ohm resistor voltage divider or logic level converter!
ULTRASONIC_ENABLED=true
ULTRASONIC_1_TRIG=25
ULTRASONIC_1_ECHO=8
ULTRASONIC_2_TRIG=7
ULTRASONIC_2_ECHO=1
ULTRASONIC_MAX_DISTANCE_CM=300.0
ULTRASONIC_STOP_DISTANCE_CM=25.0
ULTRASONIC_SLOW_DISTANCE_CM=50.0

# --- OLED Display (1.3" I2C SH1106) ---
OLED_ENABLED=true
OLED_DRIVER=sh1106
OLED_ADDRESS=0x3C
OLED_BUS=1
OLED_WIDTH=128
OLED_HEIGHT=64

# --- Camera (Raspberry Pi CSI OV5647 5MP) ---
CAMERA_ENABLED=true
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_BACKEND=picamera2
CAMERA_WATCHDOG_TIMEOUT=2.0

# --- Classical OpenCV Vision & Safety Zone ---
# No pretrained deep learning models are used. Classical MOG2 + HOG/SVM pipeline.
PERSON_CONFIDENCE_THRESHOLD=0.55
PERSON_MIN_AREA_RATIO=0.03
STOP_ZONE_X_MIN=0.20
STOP_ZONE_X_MAX=0.80
PERSON_CLEAR_DELAY=1.5
PERSON_DETECTED_CONFIRM_FRAMES=2
AUTO_RESUME_AFTER_PERSON_CLEAR=false
PERSON_DETECTION_MOCK=false

# --- Kinematic Odometry & Autonomous Navigation ---
# DC motors currently lack wheel encoders. Estimation has confidence decay.
ODOMETRY_WHEEL_BASE_M=0.22
ODOMETRY_MAX_LINEAR_SPEED_M_S=0.60
ODOMETRY_MAX_ANGULAR_SPEED_RAD_S=2.50
PATROL_IDLE_TIMEOUT_SECONDS=300.0

# --- Network & REST / WebSocket Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
ROBOT_ID=RBT01
ROBOT_NAME=Pi Robot Mall Concierge
PAIRING_ENABLED=true
PAIRING_CODE_TTL=120.0
DRIVE_COMMAND_TIMEOUT=0.35
DRIVE_COMMAND_INTERVAL=0.10
HEARTBEAT_INTERVAL=0.50
CONNECTION_TIMEOUT=1.20
TELEMETRY_INTERVAL=0.25
CAMERA_STREAM_FPS=8.0
CAMERA_STREAM_WIDTH=640
CAMERA_STREAM_HEIGHT=480
CAMERA_JPEG_QUALITY=70
STREAM_TICKET_TTL=300.0

# --- OpenRouter AI Concierge Integration ---
# Keep real API key in local .env, NEVER commit to version control!
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=10.0
